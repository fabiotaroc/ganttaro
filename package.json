{
  "name": "ganttaro",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "prettier --check . && npm run lint --workspace apps/web",
    "format": "prettier --write .",
    "test": "vitest run",
    "convex:dev": "convex dev",
    "build:vercel": "convex deploy --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL --cmd 'npm run build'"
  },
  "dependencies": {
    "@convex-dev/presence": "0.4.0",
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/react": "0.1.0-beta.1",
    "convex": "1.50.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "convex-test": "0.0.71",
    "jsdom": "29.1.1",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "type": "module",
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
